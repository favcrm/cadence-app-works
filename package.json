{
  "name": "cadence-app-works-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "dev:mockup": "python3 -m http.server 4173 --directory design/mockup",
    "host": "node src/host/server.mjs",
    "works": "node scripts/works.mjs",
    "preview": "node scripts/dev-preview.mjs",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build": "node scripts/build_screen.mjs",
    "verify": "node scripts/verify_screen.mjs",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "check": "node scripts/check-scaffold.mjs && node --test --test-force-exit tests/*.test.mjs"
  },
  "dependencies": {
    "@cadence/app-kit": "file:app-kit",
    "@cadence/screen-ui": "file:.cadence-ui/cadence-screen-ui-1.0.0.tgz",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
